# Recursive exclusions for parent git root
**/node_modules
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Launcher sentinel flag
**/.deps_ok

# Build directories
**/dist
**/dist-ssr

# Local environment configuration files
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.staging

# Editor configurations and OS files
.vscode
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

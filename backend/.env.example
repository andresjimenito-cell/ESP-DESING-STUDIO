# =========================================================================
# ESP DESIGN STUDIO - PLANTILLA DE CONFIGURACIÓN LOCAL (BACKEND)
# =========================================================================
# Guarda este archivo como ".env" dentro de la misma carpeta /backend/
# para habilitar la sincronización de OneDrive y las llamadas a la IA (Copilot).
# =========================================================================

# Puerto en el que se ejecuta el servidor Express del backend
PORT=4000

# Clave secreta para la generación de tokens de sesión local (JWT)
# Cambia esta clave en producción por razones de seguridad.
JWT_SECRET=frontera-secret-key-129847129

# Contraseña de acceso requerida por la interfaz para conectarse al backend local
LOGIN_PASSWORD=Frontera2026!

# API Key de OpenRouter para habilitar el streaming de la IA de Copilot
# Regístrate en https://openrouter.ai/ para obtener una clave.
OPENROUTER_API_KEY=

# -------------------------------------------------------------------------
# CONFIGURACIÓN DE MICROSOFT GRAPH / ONEDRIVE CORPORATIVO
# -------------------------------------------------------------------------
# Ejecuta 'node scripts/onedrive-setup-auth.cjs' desde la carpeta 'app_unified'
# para obtener y configurar estos valores de manera automática.

# ID de Cliente de la aplicación registrada en Azure Portal
ONEDRIVE_CLIENT_ID=

# Valor de la clave secreta del cliente generada en Azure Portal
ONEDRIVE_CLIENT_SECRET=

# Token de refresco (obtenido al completar el flujo de autorización OAuth2)
ONEDRIVE_REFRESH_TOKEN=

# ID del archivo Excel de Diseños Maestra (DATAS DE DISEÑO.xlsx) en OneDrive
ONEDRIVE_FILE_ID_DESIGNS=

# ID del archivo Excel de SCADA y Pruebas de Producción (PRUEBAS DE PRODUCCION.xlsx)
ONEDRIVE_FILE_ID_SCADA=

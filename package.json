{
  "name": "esp-design-studio-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app_unified",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=app_unified",
    "dev:backend": "node --watch backend/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace=app_unified"
  },
  "dependencies": {
    "vite": "^6.2.0",
    "typescript": "~5.8.2",
    "lightningcss": "^1.31.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
